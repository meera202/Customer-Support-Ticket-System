# QA / staging / integration testing stack (parallel-safe with other env.* files)
COMPOSE_PROJECT_NAME=cst-testing
IMAGE_TAG_SUFFIX=test

NODE_ENV=test
RESTART_POLICY=unless-stopped

JWT_SECRET=test-ci-jwt-not-for-production

MONGO_VOLUME_NAME=mongo_testing
MONGO_DB_AUTH=cst_auth_test
MONGO_DB_TICKETS=cst_ticket_test
MONGO_DB_NOTIFICATIONS=cst_notify_test

FRONTEND_HOST_PORT=8081

MONGO_HOST_PORT=27018
