# Production-style local stack — change JWT_SECRET before any real deployment
COMPOSE_PROJECT_NAME=cst-production
IMAGE_TAG_SUFFIX=prod

NODE_ENV=production
RESTART_POLICY=unless-stopped

JWT_SECRET=prod-local-change-this-long-random-secret

MONGO_VOLUME_NAME=mongo_production
MONGO_DB_AUTH=cst_auth_prod
MONGO_DB_TICKETS=cst_ticket_prod
MONGO_DB_NOTIFICATIONS=cst_notify_prod

FRONTEND_HOST_PORT=8082

MONGO_HOST_PORT=27020
