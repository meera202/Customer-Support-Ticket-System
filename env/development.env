# Development stack — run: docker compose --env-file env/development.env --project-name "${COMPOSE_PROJECT_NAME}" up -d --build
COMPOSE_PROJECT_NAME=cst-development
IMAGE_TAG_SUFFIX=dev

NODE_ENV=development
RESTART_POLICY=unless-stopped

JWT_SECRET=dev-shared-jwt-change-me

MONGO_VOLUME_NAME=mongo_development
MONGO_DB_AUTH=cst_auth_dev
MONGO_DB_TICKETS=cst_ticket_dev
MONGO_DB_NOTIFICATIONS=cst_notify_dev

FRONTEND_HOST_PORT=8080

MONGO_HOST_PORT=27021
