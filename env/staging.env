# Staging / pre-production Compose stack (isolate from testing when both are needed)
COMPOSE_PROJECT_NAME=cst-staging
IMAGE_TAG_SUFFIX=staging

NODE_ENV=staging
RESTART_POLICY=unless-stopped

JWT_SECRET=staging-shared-jwt-not-for-prod-use

MONGO_VOLUME_NAME=mongo_staging
MONGO_DB_AUTH=cst_auth_staging
MONGO_DB_TICKETS=cst_ticket_staging
MONGO_DB_NOTIFICATIONS=cst_notify_staging

FRONTEND_HOST_PORT=8090

MONGO_HOST_PORT=27019
